{
    "layer": "top",
    "position": "top",
    "margin-top": 5,
    "margin-left": 10,
    "margin-right": 10,
    "height": 30,

    "modules-left": ["sway/workspaces", "custom/media"],
    "modules-center": ["clock"],
    "modules-right": ["cpu", "temperature", "custom/gpu", "memory", "group/tray-drawer", "custom/padd"],

    "sway/workspaces": { "format": "{name}" },

    "custom/media": {
        "format": "{}", // Ноту убрал совсем, как ты и хотел
        "max-length": 30,
        "exec": "playerctl metadata --format '{{artist}} - {{title}}' --follow 2>/dev/null",
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl volume 0.05+",
        "on-scroll-down": "playerctl volume 0.05-"
    },

    "cpu": { "format": " {usage}%" },
    "temperature": { "format": " {temperatureC}°C" },

    "custom/gpu": {
        "exec": "nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits",
        "interval": 2,
        "format": "   {}°C" // Это иконка видеокарты (чип)
    },

    "memory": { "format": " {used}G" },
    "clock": { 
        "format": " {:%H:%M}", 
        "format-alt": " {:%d.%m}",
        "on-click": "mode" 
    },

    "group/tray-drawer": {
        "orientation": "horizontal",
        "drawer": { "transition-duration": 500, "click-to-reveal": true },
        "modules": ["custom/tray-icon", "tray"]
    },

    "custom/tray-icon": { "format": "" },
    "tray": { "icon-size": 21, "spacing": 10 },
    "custom/padd": { "format": "  " }
}
